NODE_ENV=
PORT=
CLIENT_URL=

# MongoDB Atlas connection string (include the database name before the "?")
MONGODB_URI=

# Generate with: node -p "crypto.randomBytes(48).toString('hex')"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=
REFRESH_TOKEN_DAYS=

# Used only by: npm run seed:admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP. If SMTP_HOST is empty, emails are printed in the server log instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=